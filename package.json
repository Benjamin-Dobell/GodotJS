{
  "name": "@godot-js/editor",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0+sha1.4048eeefd564ff1ab248fac3e2854d38245fe2f1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "node scripts/test/run-runtime-matrix.mts",
    "test:skip-builds": "node scripts/test/run-runtime-matrix.mts --skip-builds",
    "test:web-bridge-profile": "node scripts/test/test-web-bridge-profile.mjs",
    "test:web-bound-object-conversion": "node scripts/test/test-web-bound-object-conversion.mjs",
    "test:web-cache-lookup": "node scripts/test/test-web-cache-lookup.mjs",
    "test:web-identity-hash": "node scripts/test/test-web-identity-hash.mjs",
    "test:web-numeric-value": "node scripts/test/test-web-numeric-value.mjs",
    "test:web-property-undefined": "node scripts/test/test-web-property-undefined.mjs",
    "test:web-promise-rejection-scope": "node scripts/test/test-web-promise-rejection-scope.mjs",
    "test:web-weak-handle-resolve": "node scripts/test/test-web-weak-handle-resolve.mjs",
    "test:web-weak-global-reset": "node scripts/test/test-web-weak-global-reset.mjs",
    "build:web:commonjs-template": "scons -C ../.. platform=web target=template_release skip_js_runtime=yes threads=no dlink_enabled=no nodejs_runtime=yes",
    "export:web:commonjs": "node scripts/test/export-web-commonjs.js",
    "run:web:commonjs": "node scripts/test/run-web-commonjs-export-under-node.js",
    "test:web:commonjs": "node scripts/test/run-web-commonjs-smoke.js",
    "changeset": "changeset",
    "ci:should-publish": "node scripts/release/should-publish.js",
    "ci:publish": "node scripts/release/publish.js",
    "ci:test-project": "node scripts/release/test-project.js",
    "ci:version": "changeset version && node scripts/release/version.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@types/node": "^24.12.2"
  }
}
